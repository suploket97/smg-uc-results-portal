# Supabase → Project → Connect → "Transaction pooler" connection string (port 6543).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# The one password for every admin page.
ADMIN_PASSWORD=change-me

# Optional: any long random string. Changing it signs everyone out.
SESSION_SECRET=

# Optional: Vercel sends this to the keep-alive cron automatically when set.
CRON_SECRET=

# Optional: time zone used for times in the Excel export (default Europe/London).
EVENT_TIMEZONE=Europe/London
